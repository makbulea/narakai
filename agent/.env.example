# Copy to .env and fill in real values (or export these directly). Never commit the real .env file.

# Official Anthropic API key (https://console.anthropic.com/) — used by AnthropicLlmClient.
ANTHROPIC_API_KEY=

# Must be the SAME signing key backend's CustomerService TokenIssuer uses (backend/.env's
# JWT_SIGNING_KEY), so a token minted there also authorizes calls to this service.
# Note the double underscore: that's the ASP.NET Core convention for binding an env var
# to the nested config key Jwt:SigningKey — a single-underscore JWT_SIGNING_KEY here would
# silently not bind, and AddJwtAuth would fail at startup with "Jwt:SigningKey is not configured".
Jwt__SigningKey=

# Base URL of the running CodeIntelligence.Rag.Api instance (defaults to
# http://localhost:5151 in appsettings.json — override only if it runs elsewhere).
# Services__Rag=http://localhost:5151
