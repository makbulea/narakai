{
  "ConnectionStrings": {
    "PaymentDb": "Host=localhost;Port=5432;Database=payment_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "payment-service",
    "MaxDeliveryAttempts": 5,
    "RetryBaseDelayMs": 500
  },
  "Outbox": {
    "PollIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "PaymentProvider": {
    "FailureRate": 0.15,
    "MinLatencyMs": 50,
    "MaxLatencyMs": 400,
    "TimeoutRate": 0.02
  },
  "Jwt": {
    "Issuer": "ecommerce-local",
    "Audience": "ecommerce-api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}