{
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=notification_db;Username=postgres;Password=postgres"
  },
  "Services": {
    "Customer": "http://localhost:5001",
    "Order": "http://localhost:5004"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "notification-service",
    "MaxDeliveryAttempts": 5,
    "RetryBaseDelayMs": 500
  },
  "Outbox": {
    "PollIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Jwt": {
    "Issuer": "ecommerce-local",
    "Audience": "ecommerce-api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}