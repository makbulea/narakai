{
  "ConnectionStrings": {
    "CustomerDb": "Host=localhost;Port=5432;Database=customer_db;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "customer-service",
    "MaxDeliveryAttempts": 5,
    "RetryBaseDelayMs": 500
  },
  "Outbox": {
    "PollIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Jwt": {
    "Issuer": "ecommerce-local",
    "Audience": "ecommerce-api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
