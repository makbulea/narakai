# Copy to .env before running docker compose. .env is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Must be at least 32 bytes for HS256. Generate a real one:
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-dev-only-signing-key-at-least-32-bytes-long

ASPNETCORE_ENVIRONMENT=Development

# Fraction of simulated card declines. Set to 0 for a deterministic happy path,
# or raise it to exercise the compensation flow.
PAYMENT_FAILURE_RATE=0.15
